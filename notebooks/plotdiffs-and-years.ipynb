   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import yaml\n",
    "from pathlib import Path\n",
    "import seaborn as sns\n",
    "import matplotlib.pyplot as plt"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def load_config_data(config_root):\n",
    "    \"\"\"Loads all YAML configs from a directory into a pandas DataFrame.\"\"\"\n",
    "    all_results_data = []\n",
    "    for config_file in config_root.glob(\"**/*.yaml\"):\n",
    "        with open(config_file, 'r') as f:\n",
    "            config = yaml.safe_load(f)\n",
    "        \n",
    "        metrics = config.pop(\"evaluation_metrics\", {})
",
    "        config.update(metrics)\n",
    "        config['experiment_name'] = config_file.parent.name\n",
    "        all_results_data.append(config)\n",
    "    \n",
    "    if not all_results_data:\n",
    "        return pd.DataFrame()\n",
    "        \n",
    "    return pd.DataFrame(all_results_data)\n",
    "\n",
    "# === SETTINGS ===\n",
    "TICKER = \"MSFT\"\n",
    "TIMEFREQ = \"1d\"\n",
    "# =================\n",
    "\n",
    "config_root = Path(\"../configs\") / TICKER / TIMEFREQ\n",
    "df_full = load_config_data(config_root)\n",
    "\n",
    "if df_full.empty:\n",
    "    print(f\"No data found for {TICKER}/{TIMEFREQ}\")\n",
    "else:\n",
    "    print(\"Data loaded successfully.\")\n",
    "    display(df_full.head())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Pivot table to see MAPE scores\n",
    "if not df_full.empty:\n",
    "    pivot_mape = df_full.pivot_table(\n",
    "        index=[\'training_period_value\', \'horizon_length'], \n",
    "        columns=\'forecasting_method', \n",
    "        values=\'mape',\n",
    "        aggfunc=\'mean'\n",
    "    )\n",
    "    display(pivot_mape.style.background_gradient(cmap=\'viridis_r', axis=1))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Plotting metrics vs. training days, faceted by horizon\n",
    "if not df_full.empty:\n",
    "    g = sns.relplot(\n",
    "        data=df_full,\n",
    "        x=\"training_period_value\",\n",
    "        y=\"mape\",\n",
    "        hue=\"forecasting_method\",\n",
    "        style=\"forecasting_method\",\n",
    "        col=\"horizon_length\",\n",
    "        kind=\"line\",\n",
    "        col_wrap=2,\n",
    "        facet_kws={"sharey": False, "sharex": True}\n",
    "    )\n",
    "    g.fig.suptitle(f\'MAPE vs. Training Days for {TICKER} ({TIMEFREQ})\', y=1.03)\n",
    "    plt.show()"
   ]
  }
 ],
